NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_API_HOST=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend auth endpoints used by the internal route handlers.
# You can use either absolute URLs or paths relative to NEXT_PUBLIC_API_HOST.
AUTH_REFRESH_PATH=/auth/refresh
AUTH_LOGOUT_PATH=/auth/logout
AUTH_GOOGLE_SIGNIN_PATH=
AUTH_GITHUB_SIGNIN_PATH=

# Used by verifySignedToken in server utilities when needed.
PASSWORD_VERIFY_SECRET=change-me

# Google Identity Services client ID used by the auth pages.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
