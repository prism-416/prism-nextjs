NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_API_HOST=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend auth endpoints used by the internal refresh/logout route handlers.
# You can use either absolute URLs or paths relative to NEXT_PUBLIC_API_HOST.
AUTH_REFRESH_PATH=/api/auth/refresh
AUTH_LOGOUT_PATH=/api/auth/logout

# Used by verifySignedToken in server utilities when needed.
PASSWORD_VERIFY_SECRET=change-me
